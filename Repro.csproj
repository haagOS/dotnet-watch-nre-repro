<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Stands in for any failure of the design-time build that dotnet watch runs when it
       re-evaluates the project. While the file 'break-evaluation' exists, that build fails. -->
  <Target Name="FailWhileMarkerExists" BeforeTargets="CoreCompile">
    <Error Condition="Exists('$(MSBuildProjectDirectory)/break-evaluation')"
           Text="break-evaluation exists: failing on purpose." />
  </Target>

</Project>
